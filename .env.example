# ============================================================
# PaperMill Hunter 环境变量模板
# ------------------------------------------------------------
# 用法：复制本文件为 .env，填入你自己的信息。.env 已在 .gitignore 中，
#      不会被提交到 GitHub —— 这是"密钥/个人信息不进版本库"的基本纪律。
#
#   PowerShell:  Copy-Item .env.example .env
# ============================================================

# 【必填】你的邮箱。
# 为什么需要？OpenAlex / Crossref 提供"礼貌池"(polite pool)：
# 带上真实邮箱的请求会被识别为学术用途，限流更宽松、稳定性更高。
# 这也是一种数据伦理：让对方知道是谁在请求，而不是匿名刷接口。
PMH_CONTACT_EMAIL=jie69612@gmail.com

# ---------------- 采集行为（一般不用改） ----------------
# 单个请求的超时秒数
PMH_HTTP_TIMEOUT=30
# 失败重试次数（含首次尝试）
PMH_HTTP_MAX_RETRIES=5
# 大文件下载专用的读超时（秒）。
# 取值权衡：太短会在网络正常停顿时误判失败并从头重下；太长则连接真断了还要干等。
# 90 秒是实测出来的平衡点。
PMH_DOWNLOAD_READ_TIMEOUT=90
# 下载失败后的重试次数（该端点不支持 Range 续传，每次重试都从零开始）
PMH_DOWNLOAD_MAX_ATTEMPTS=8
# 各数据源限流：每秒最多发几个请求
PMH_OPENALEX_QPS=8
PMH_CROSSREF_QPS=5
# 磁盘缓存有效期（秒）。默认 7 天；调试时可设为 0 强制走网络。
PMH_CACHE_TTL_SECONDS=604800

# 是否沿用系统代理。
# 【保持 false，除非你明确知道自己需要代理】
# httpx 默认会读取 Windows 注册表里的系统代理。如果你本机跑着 Clash / V2Ray，
# 请求会被静默塞进那个代理，可能报出误导性的 SSL: WRONG_VERSION_NUMBER 错误。
# 如果你在公司内网必须走代理出网，改成 true。
PMH_HTTP_TRUST_ENV=false

# git 是否沿用全局/系统代理配置。
# 同上：如果你本机 git 配了代理而 gitlab.com 拉不动，保持 false 即可。
# 本管道只用 `git -c` 临时覆盖，不会改动你的全局 git 配置。
PMH_GIT_USE_PROXY=false

# 日志级别：DEBUG / INFO / WARNING / ERROR
PMH_LOG_LEVEL=INFO
